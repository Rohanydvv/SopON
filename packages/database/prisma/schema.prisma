generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ENGINEER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  CLOSED
  REOPENED
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentPriority {
  P1
  P2
  P3
  P4
}

enum ServiceEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
  MAINTENANCE
}

enum AIAnalysisType {
  CLASSIFICATION
  SUMMARIZATION
  INVESTIGATION
  RCA
  RESOLUTION_SUGGESTION
}

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SLACK
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships       Membership[]
  teamMemberships   TeamMember[]
  assignedIncidents Incident[]        @relation("IncidentAssignee")
  incidentComments  IncidentComment[]
  timelineEvents    IncidentTimeline[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("FREE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  invitations        Invitation[]
  teams              Team[]
  services           Service[]
  incidents          Incident[]
  integrations       Integration[]
  slaPolicies        SLAPolicy[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  aiAnalyses         AIAnalysis[]
  notifications      Notification[]
  webhookEndpoints   WebhookEndpoint[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole         @default(ENGINEER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           UserRole  @default(ENGINEER)
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members             TeamMember[]
  services            Service[]
  incidents           Incident[]
  incidentAssignments IncidentAssignment[]

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Service {
  id             String             @id @default(uuid())
  organizationId String
  teamId         String?
  name           String
  slug           String
  description    String?
  tier           String             @default("Tier 2")
  environment    ServiceEnvironment @default(PRODUCTION)
  status         ServiceStatus      @default(OPERATIONAL)
  repositoryUrl  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  incidents    Incident[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("services")
}

model Incident {
  id              String           @id @default(uuid())
  organizationId  String
  serviceId       String?
  teamId          String?
  assigneeId      String?
  title           String
  description     String
  status          IncidentStatus   @default(OPEN)
  severity        IncidentSeverity @default(MEDIUM)
  priority        IncidentPriority @default(P3)
  source          String           @default("MANUAL")
  metadataJson    Json?
  detectedAt      DateTime         @default(now())
  acknowledgedAt  DateTime?
  investigatingAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assigneeUser User?                @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events       IncidentEvent[]
  comments     IncidentComment[]
  timeline     IncidentTimeline[]
  assignments  IncidentAssignment[]
  sla          IncidentSLA?
  aiAnalyses   AIAnalysis[]

  @@index([organizationId, status, severity, createdAt])
  @@index([organizationId, teamId, status])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, serviceId, createdAt])
  @@map("incidents")
}

model IncidentEvent {
  id          String   @id @default(uuid())
  incidentId  String
  type        String
  payloadJson Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt])
  @@map("incident_events")
}

model IncidentComment {
  id         String   @id @default(uuid())
  incidentId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_comments")
}

model IncidentTimeline {
  id           String   @id @default(uuid())
  incidentId   String
  actorUserId  String?
  eventType    String
  message      String
  metadataJson Json?
  createdAt    DateTime @default(now())

  incident  Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorUser User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_timeline")
}

model IncidentAssignment {
  id           String    @id @default(uuid())
  incidentId   String
  teamId       String?
  userId       String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  team     Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([incidentId, assignedAt])
  @@map("incident_assignments")
}

model Integration {
  id             String   @id @default(uuid())
  organizationId String
  type           String
  name           String
  key            String   @unique
  secret         String
  configJson     Json?
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@map("integrations")
}

model SLAPolicy {
  id                String           @id @default(uuid())
  organizationId    String
  severity          IncidentSeverity
  responseMinutes   Int
  resolutionMinutes Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, severity])
  @@map("sla_policies")
}

model IncidentSLA {
  id                   String    @id @default(uuid())
  incidentId           String    @unique
  responseDueAt        DateTime?
  resolutionDueAt      DateTime?
  responseBreachedAt   DateTime?
  resolutionBreachedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([responseDueAt, resolutionDueAt])
  @@map("incident_slas")
}

model KnowledgeDocument {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  sourceType     String   @default("DOCUMENT")
  sourceUrl      String?
  content        String
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([organizationId, createdAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String                 @id @default(uuid())
  documentId     String
  organizationId String
  content        String
  embedding      Unsupported("vector")?
  metadataJson   Json?
  createdAt      DateTime               @default(now())

  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("knowledge_chunks")
}

model AIAnalysis {
  id             String           @id @default(uuid())
  organizationId String
  incidentId     String
  type           AIAnalysisType
  status         AIAnalysisStatus @default(PENDING)
  model          String
  promptVersion  String
  inputHash      String
  outputJson     Json?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([organizationId, incidentId, type])
  @@map("ai_analyses")
}

model Notification {
  id             String              @id @default(uuid())
  organizationId String
  userId         String
  type           String
  channel        NotificationChannel @default(IN_APP)
  payloadJson    Json
  sentAt         DateTime            @default(now())
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model WebhookEndpoint {
  id             String   @id @default(uuid())
  organizationId String
  url            String
  secretHash     String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("webhook_endpoints")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String    @unique
  scopes         String[]  @default(["ingest:events"])
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, keyPrefix])
  @@map("api_keys")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  metadataJson   Json?
  ipHash         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}