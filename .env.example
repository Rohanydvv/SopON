# Application Environment (development | staging | production | test)
APP_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Connection
DATABASE_URL=postgresql://sopon:sopon_secret@localhost:5432/sopon_db?schema=public
POSTGRES_USER=sopon
POSTGRES_PASSWORD=sopon_secret
POSTGRES_DB=sopon_db
POSTGRES_PORT=5432

# Redis Connection
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Authentication & Security
AUTH_SECRET=super-secret-jwt-key-replace-in-production-at-least-32-chars
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration (gemini | openai)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-1.5-flash

# Email Configuration (Resend or local Mailpit for dev)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=notifications@sopon.dev
EMAIL_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# Observability
LOG_LEVEL=debug
SENTRY_DSN=
